{
  "version": "knowledge-convergence-policy/v1",
  "updated_at": "2026-04-11T12:26:00+08:00",
  "max_action_task_depth": 2,
  "max_result_feedback_task_depth": 2,
  "stop_candidate_types_at_depth": {
    "decision": 2,
    "rule": 2,
    "fact": 2,
    "lesson": 2,
    "preference": 2
  },
  "human_review_only_at_depth": 2,
  "terminal_action_types_after_result": [
    "review_decision_candidate",
    "review_rule_candidate",
    "verify_fact_candidate",
    "refine_lesson_candidate",
    "align_preference_candidate"
  ],
  "notes": [
    "默认允许知识候选驱动第一轮和第二轮自动协作。",
    "超过阈值后，不再自动继续发动作或继续扩 result-derived candidate。",
    "超过阈值的结果仍允许写知识页、blackboard 和审计，但进入人工 review 收口。"
  ]
}
